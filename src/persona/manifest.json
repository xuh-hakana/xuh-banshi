{
  "note": "人设层清单（2026-11-25）。物理文件与 F/H/D 分区不动，只在这里声明：哪一层、哪些文件、给谁用、什么场景注入。改层先改这里。",
  "layers": {
    "F": {
      "name": "全场景通用主人设",
      "dir": "soul/F-全场景通用主人设",
      "always": true,
      "files": [
        "虚幻.md",
        "0-我的喜好.md",
        "1-性格.md",
        "2-说话.md",
        "功能词典.md",
        "3-接龙结束词.md"
      ],
      "inject": "常驻：所有场景、所有模型都读（core.readSoul）"
    },
    "H": {
      "name": "全聊天应对语气",
      "dir": "soul/H-全聊天",
      "always": true,
      "files": [
        "3-应对.md"
      ],
      "inject": "「公共」块常驻；「我/别人」按说话人挑；场合文件命中才注入"
    },
    "D": {
      "name": "平台功能",
      "dir": "soul/D-平台功能",
      "always": false,
      "files": [
        "空间评论写法.md"
      ],
      "inject": "只给对应平台功能用，不进聊天主链路"
    }
  },
