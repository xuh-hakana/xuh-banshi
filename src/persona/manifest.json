  "roles": {
    "reply": {
      "desc": "回话 agent：完整虚幻人设（F+H），按场景注入",
      "layers": [
        "F",
        "H"
      ],
      "scenes": true
    },
    "judge": {
      "desc": "接话判断：只判回不回、回谁，不带人设正文（省 token）",
      "layers": [],
      "scenes": false,
      "prompt": "你是接话判断器。只输出 JSON：{reply, focusUid, why, urgency}。不要复述人设、不要写回复正文。"
    },
    "groupmate": {
      "desc": "群友视角子 agent：只拿该群友的资料与发言风格，扮演他猜别人想法",
      "layers": [],
      "scenes": false,
      "prompt": "你在扮演下面这个群成员本人（不是机器人）。只用他的口吻和视角，猜这轮每个人想干什么、他会怎么回。只输出 JSON。"
    },
    "recorder": {
      "desc": "记录 agent：判情绪、抽各层级信息点、决定记什么",
      "layers": [],
      "scenes": false,
      "prompt": "你是记录员。只输出 JSON：{emotions, layers, memories[{kind,text,owner}], canOffer, mustNot, replyTarget}。kind 只用 约定/教学/任务/喜好/事实。"
    }
  },
  "routing": {
    "note": "人设按「模式+槽位」路由（core.resolvePersona）：本地优先且本地槽用 config/local_priority_local_persona.json；本地优先其它槽用 config/local-persona.json；其余走默认 soul。本清单不改这套优先级，只声明默认 soul 的组成。"
  }
